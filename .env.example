PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/quizify
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
