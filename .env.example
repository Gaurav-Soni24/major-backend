PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/quizify
# Required. Long random string used to sign teacher JWTs.
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Comma-separated list; keys are rotated automatically when a quota is hit
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2

# ---- Optional (safe defaults) ----
# Comma-separated list of allowed browser origins, e.g. https://your-frontend.vercel.app
# If unset: any origin in development, same host only in production.
CORS_ORIGIN=
# Secret for student and attempt tokens. Defaults to JWT_SECRET.
STUDENT_TOKEN_SECRET=
# Seconds of tolerance after an attempt's deadline before answers are rejected (default 15).
ATTEMPT_GRACE_SECONDS=15
# Number of reverse proxies in front of the app (1 on Render). Needed for correct per-IP rate limits.
TRUST_PROXY=
